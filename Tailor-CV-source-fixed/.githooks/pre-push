#!/bin/sh
# Pre-push gate: block the push unless type check, security audit,
# and build all pass. Run manually with: sh .githooks/pre-push

echo ""
echo "🚦 Pre-push gate: running checks…"
echo ""

set -e

# 1. Type check
echo "── 1/3 Type check (tsc --noEmit)"
if ! npx tsc --noEmit; then
  echo ""
  echo "❌ BLOCKED: TypeScript errors. Fix them before pushing."
  exit 1
fi
echo "   ✅ Type check passed"
echo ""

# 2. Security audit (high/critical must be zero)
echo "── 2/3 Security audit (npm audit --audit-level=high)"
AUDIT_OUTPUT=$(npm audit --audit-level=high 2>&1) || true
HIGH_COUNT=$(echo "$AUDIT_OUTPUT" | grep -oE "[0-9]+ high" | grep -oE "[0-9]+" | head -1)
CRIT_COUNT=$(echo "$AUDIT_OUTPUT" | grep -oE "[0-9]+ critical" | grep -oE "[0-9]+" | head -1)
HIGH_COUNT=${HIGH_COUNT:-0}
CRIT_COUNT=${CRIT_COUNT:-0}
if [ "$HIGH_COUNT" -gt 0 ] || [ "$CRIT_COUNT" -gt 0 ]; then
  echo ""
  echo "❌ BLOCKED: $HIGH_COUNT high, $CRIT_COUNT critical vulnerabilities."
  echo "   Run: npm audit fix"
  exit 1
fi
echo "   ✅ Security audit passed (0 high, 0 critical)"
echo ""

# 3. Frontend build
echo "── 3/3 Build (vite build)"
if ! npx vite build; then
  echo ""
  echo "❌ BLOCKED: Build failed. Fix it before pushing."
  exit 1
fi
echo "   ✅ Build passed"
echo ""

echo "✅ All pre-push checks passed — safe to push."
echo ""
